<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.patbaumgartner</groupId>
    <artifactId>prune-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>prune-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>

  <name>prune-maven-plugin</name>
  <description>Maven mojos exposing the prune-java check and fix goals</description>

  <prerequisites>
    <maven>${maven.version}</maven>
  </prerequisites>

  <dependencies>
    <dependency>
      <groupId>com.patbaumgartner</groupId>
      <artifactId>prune-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${maven-plugin-tools.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <configuration>
          <goalPrefix>prune</goalPrefix>
        </configuration>
      </plugin>
      <!-- Mojos report through the Maven log, never through System.out. -->
      <plugin>
        <groupId>de.thetaphi</groupId>
        <artifactId>forbiddenapis</artifactId>
        <configuration>
          <bundledSignatures combine.children="append">
            <bundledSignature>jdk-system-out</bundledSignature>
          </bundledSignatures>
        </configuration>
      </plugin>

      <!--
        Integration tests: invokes the packaged plugin against samples/maven-sample
        through a real Maven process. Unit tests cannot catch goal-invocation
        failures such as a @Parameter declared with a type Maven cannot inject.
        Skip with -Dinvoker.skip=true.

        The goals are listed here rather than in an invoker.properties beside the
        sample: the sample stays a clean standalone project, and ${project.version}
        interpolates here whereas invoker.properties is not filtered. They are also
        invoked directly rather than through a lifecycle phase, so the sample's own
        dependencies are never resolved and the ITs stay offline-safe.

        The sample deliberately contains dead code, so check would fail the forked
        build; prune.failOnIssues=false keeps this IT about invocability while the
        findings themselves are asserted by prune-core's SampleProjectFixtureTest.
        fix then rewrites the clone under target/it, never the sample itself, baseline
        records what fix left behind, and the final check shows every remaining
        finding suppressed by that baseline in build.log.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-invoker-plugin</artifactId>
        <configuration>
          <projectsDirectory>${project.basedir}/../samples</projectsDirectory>
          <pomIncludes>
            <pomInclude>maven-sample/pom.xml</pomInclude>
          </pomIncludes>
          <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
          <localRepositoryPath>${project.build.directory}/local-repo</localRepositoryPath>
          <extraArtifacts>
            <extraArtifact>org.junit:junit-bom:${junit.version}:pom</extraArtifact>
          </extraArtifacts>
          <properties>
            <prune.failOnIssues>false</prune.failOnIssues>
          </properties>
          <goals>
            <goal>com.patbaumgartner:prune-maven-plugin:${project.version}:check</goal>
            <goal>com.patbaumgartner:prune-maven-plugin:${project.version}:fix</goal>
            <goal>com.patbaumgartner:prune-maven-plugin:${project.version}:baseline</goal>
            <goal>com.patbaumgartner:prune-maven-plugin:${project.version}:check</goal>
          </goals>
        </configuration>
        <executions>
          <execution>
            <id>sample-projects</id>
            <goals>
              <goal>install</goal>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <url>https://github.com/patbaumgartner/prune-java</url>
</project>
