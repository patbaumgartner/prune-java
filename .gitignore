# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven
target/

# Gradle (prune-gradle-plugin is a standalone Gradle build)
.gradle/
**/build/

# The wrapper jar must be committed so a clean clone can build; it is re-included
# here because the "*.jar" rule above would otherwise exclude it.
!prune-gradle-plugin/gradle/wrapper/gradle-wrapper.jar

# Unlazy build artifacts
.unlazy/
