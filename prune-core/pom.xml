<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patbaumgartner</groupId>
        <artifactId>prune-java</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>prune-core</artifactId>

    <name>prune-core</name>
    <description>Shared analysis configuration, report model, and analyzer abstractions</description>

    <!-- prune-core has no runtime dependencies on purpose. Do not add any. -->
    <dependencies>
        <!-- Test scope only: FuzzedDataProvider for ParserFuzzer; the driver itself runs in the
        fuzz profile. -->
        <dependency>
            <groupId>com.code-intelligence</groupId>
            <artifactId>jazzer-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <!-- Explicit, because the flattened POM would otherwise append the module name to the parent
    URL. -->
    <url>https://github.com/patbaumgartner/prune-java</url>

    <profiles>
        <!--
      ./mvnw -pl prune-core -Pfuzz test-compile exec:exec runs Jazzer against ParserFuzzer until it
      finds an input that breaks a parser invariant or the time budget below runs out. Crashing
      inputs are written to the seed corpus, where ParserFuzzerTest replays them on every build.
    -->
        <profile>
            <id>fuzz</id>
            <properties>
                <fuzz.package>com/patbaumgartner/prune/core/source</fuzz.package>
                <fuzz.seconds>120</fuzz.seconds>
                <fuzz.seeds>src/test/resources/${fuzz.package}/ParserFuzzerInputs</fuzz.seeds>
                <fuzz.target>com.patbaumgartner.prune.core.source.ParserFuzzer</fuzz.target>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.code-intelligence</groupId>
                    <artifactId>jazzer</artifactId>
                    <version>${jazzer.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <configuration>
                            <executable>java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-cp</argument>
                                <classpath></classpath>
                                <argument>com.code_intelligence.jazzer.Jazzer</argument>
                                <argument>--target_class=${fuzz.target}</argument>
                                <argument>-max_total_time=${fuzz.seconds}</argument>
                                <argument>-create_missing_dirs=1</argument>
                                <!-- Crashes land next to the seeds; the next build replays them. -->
                                <argument>-artifact_prefix=${fuzz.seeds}/</argument>
                                <argument>target/fuzz-corpus</argument>
                                <argument>${fuzz.seeds}</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>